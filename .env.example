# GEMINI_API_KEY: Required for Gemini AI medical report summarization.
# AI Studio automatically injects this at runtime from user secrets.
# For local development, set your Gemini API key from Google AI Studio.
GEMINI_API_KEY=

# MONGODB_URI: Connection string for MongoDB database.
MONGODB_URI=mongodb://localhost:27017/medisummarize

# Server Port
PORT=5000

# Doctor Portal Demo Authentication
DOCTOR_EMAIL=doctor@example.com
DOCTOR_PASSWORD=change_this_password

# Frontend API URL (when running client separately)
VITE_API_URL=http://localhost:5000

